meta {
  name: Verify Code
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/verify
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "code": "123456"
  }
}

script:post-response {
  if (res.status === 200) {
    var body = res.getBody();
    if (body.accessToken) {
      bru.setVar("accessToken", body.accessToken);
      bru.setVar("refreshToken", body.refreshToken);
    }
    if (body.signupToken) {
      bru.setVar("signupToken", body.signupToken);
    }
  }
}

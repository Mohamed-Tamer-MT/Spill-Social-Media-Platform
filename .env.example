# ---- App ----
APP_ENV=development
HTTP_PORT=8080

# ---- Supabase project ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret key or legacy service_role key>   # server-only, bypasses RLS

# ---- Database (Supabase Postgres) ----
# App runtime: transaction pooler, port 6543, role api_app
# URL-encode the password if it has special characters.
DATABASE_URL=postgres://api_app.<project-ref>:<api_app-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations only: session pooler, port 5432, role postgres
MIGRATION_DATABASE_URL=postgres://postgres.<project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Storage (Supabase Storage bucket "media") ----
STORAGE_BUCKET=media
STORAGE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media
UPLOAD_MAX_BYTES=5242880
UPLOAD_PENDING_TTL=1h

# ---- Auth (generate secrets with: openssl rand -base64 48) ----
JWT_SECRET=<at least 32 random bytes, base64>
JWT_ISSUER=social-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SIGNUP_TOKEN_TTL=10m
OTP_HMAC_KEY=<at least 32 random bytes, base64>
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s

# ---- Mail (OTP delivery) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAILER=mailpit